{
  "name": "cliqero",
  "private": true,
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cliqero/web",
    "build": "npm run build --workspace @cliqero/web",
    "start": "npm run start --workspace @cliqero/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,jsonc,yaml,yml,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,jsonc,yaml,yml,md}\"",
    "worker:outbox": "npm run worker:outbox --workspace @cliqero/web",
    "blog:migrate": "npm run blog:migrate --workspace @cliqero/web",
    "cli": "npm run cli --workspace @cliqero/web",
    "test": "npm run test --workspace @cliqero/web",
    "typecheck": "npm run typecheck --workspace @cliqero/web"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6"
  }
}
