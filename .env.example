# Public origin used to build absolute links, redirects, and callback URLs.
# It may differ from APP_PORT when a reverse proxy exposes the app publicly.
APP_URL=http://localhost:3000
# Host port Docker exposes for the web app; the container continues listening on port 3000.
APP_PORT=3000

# Local/default PostgreSQL container connection settings.
POSTGRES_DB=cliqero
POSTGRES_USER=cliqero
POSTGRES_PASSWORD=cliqero-local
POSTGRES_PORT=5432
