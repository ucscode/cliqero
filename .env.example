# Public/external application origin used for absolute links, redirects,
# callbacks, and module URLs. Include the scheme and no path, for example
# https://cliqero.example in production. This may differ from APP_PORT when a
# reverse proxy exposes the container publicly.
APP_URL=http://localhost:3000
# Host port Docker exposes for the web app. The right-hand Compose port remains
# the container's internal port 3000, so this can differ from APP_URL in production.
APP_PORT=3000

# PostgreSQL settings used by the local/default Compose database. Change these
# together with the database service configuration when connecting elsewhere.
# POSTGRES_DB is the database name; POSTGRES_USER is the login role.
POSTGRES_DB=cliqero
POSTGRES_USER=cliqero
# Local development password for that role; replace it outside local-only use.
POSTGRES_PASSWORD=cliqero-local
# Host port exposed by Docker for PostgreSQL (container port remains 5432).
POSTGRES_PORT=5432
