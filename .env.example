# See docs/operations/environment-variables.md for less-common worker, cache,
# logging, and testing settings that are intentionally not listed here.
# Public/external application origin used for absolute links, redirects,
# callbacks, and module URLs. Include the scheme and no path, for example
# https://cliqero.example in production. This may differ from APP_PORT when a
# reverse proxy exposes the container publicly.
APP_URL=http://localhost:3000
# Host port Docker exposes for the web app. The right-hand Compose port remains
# the container's internal port 3000, so this can differ from APP_URL in production.
APP_PORT=3000
# Address on the host used for the app's published port. Loopback keeps the app
# private behind a host reverse proxy by default; change only with firewalling.
APP_BIND_ADDRESS=127.0.0.1
# Shared PostgreSQL exchange-rate cache freshness/stale-if-error windows.
# Defaults are 24 hours and 48 hours respectively; values are milliseconds.
# EXCHANGE_RATE_CACHE_TTL_MS=86400000
# EXCHANGE_RATE_CACHE_STALE_TTL_MS=172800000
# Dedicated credential for discovering the generated OpenAPI schema outside
# development. It authorizes no business API operation.
OPENAPI_KEY=replace-with-a-strong-random-secret
# Persistent SQLite blog database path. Docker mounts this under /workspace/data/blog.
BLOG_DATABASE_PATH=/workspace/data/blog/blog.sqlite

# Better Auth signs browser sessions and OAuth state. Use a random value of at
# least 32 characters outside local development.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Application encryption root used to derive purpose-specific keys for
# Cliqero-controlled encrypted data. Optional until an encryption feature is
# used. Generate a local value with: openssl rand -base64 32
# Put the generated value in the untracked root .env; never commit it or reuse
# BETTER_AUTH_SECRET.
# APP_ENCRYPTION_KEY=
# Mailpit's published ports are Docker concerns; SMTP transport policy lives in
# config/modules/email.yaml (copy the tracked example locally).
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# PostgreSQL settings used by the local/default Compose database. Change these
# together with the database service configuration when connecting elsewhere.
# For production, replace these development values with a distinct database and
# strong bootstrap credentials before starting the base Compose stack.
# POSTGRES_DB is the database name; POSTGRES_USER is the login role.
POSTGRES_DB=cliqero
POSTGRES_USER=cliqero
# Local development password for that role; replace it outside local-only use.
POSTGRES_PASSWORD=cliqero-local
# Production only: restricted application login. The production Compose stack
# requires both values. Use a URL-safe random password (for example, 32 random
# bytes encoded as hex); never reuse the bootstrap POSTGRES_PASSWORD.
# POSTGRES_APP_USER=cliqero_app
# POSTGRES_APP_PASSWORD=
# Host port exposed by Docker for PostgreSQL (container port remains 5432).
POSTGRES_PORT=5432
